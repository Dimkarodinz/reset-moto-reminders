{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reset-light.invalid/schemas/ecumap.schema.json",
  "title": "Reset Moto Reminders ECU map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "motorcycle"],
  "properties": {
    "schema_version": { "const": 3 },
    "motorcycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manufacturer", "model", "model_year", "generation", "market", "modules"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "generation": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_ecu", "instrument_cluster"],
          "properties": {
            "engine_ecu": { "$ref": "#/$defs/module" },
            "instrument_cluster": { "$ref": "#/$defs/module" }
          }
        }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "family", "supplier", "identity", "transport", "commands"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "supplier": { "type": "string", "minLength": 1 },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hardware_family", "part_number", "software_version"],
          "properties": {
            "hardware_family": { "type": "string", "minLength": 1 },
            "part_number": { "type": "string", "minLength": 1 },
            "software_version": { "type": "string", "minLength": 1 }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledge_status",
            "minimal_configuration_confirmed",
            "protocol",
            "can_id_format",
            "bitrate_kbit_s",
            "request_can_id",
            "response_can_id",
            "elm_protocol_command",
            "observed_elm_adapter_configuration"
          ],
          "properties": {
            "knowledge_status": { "type": "string", "minLength": 1 },
            "minimal_configuration_confirmed": { "type": "boolean" },
            "protocol": { "type": "string", "minLength": 1 },
            "can_id_format": { "enum": ["11-bit", "29-bit"] },
            "bitrate_kbit_s": { "type": "integer", "minimum": 1 },
            "request_can_id": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
            "response_can_id": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
            "elm_protocol_command": { "type": "string", "pattern": "^AT[A-Z0-9]+$" },
            "observed_elm_adapter_configuration": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "commands": { "type": "object" }
      }
    }
  }
}
